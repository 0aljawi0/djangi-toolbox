<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DjangiToolbox.App"
             xmlns:local="using:DjangiToolbox"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://DjangiToolbox/Themes/Cyberpunk.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <FontFamily x:Key="AppMonoFont">avares://DjangiToolbox/Assets/Fonts#JetBrains Mono</FontFamily>
    </Application.Resources>
</Application>