<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:DjangiToolbox.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
		x:Class="DjangiToolbox.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Icon="/Assets/app.ico"
		Title="DjangiToolbox"
		Width="1100" Height="800"
		MinWidth="900" MinHeight="750"
		WindowDecorations="None"
		WindowStartupLocation="CenterScreen"
		Background="{DynamicResource CyberBg}"
		Opacity="0">

	<Grid RowDefinitions="44,*">
		<!-- ===== Custom Cyberpunk Title Bar ===== -->
		<Border Grid.Row="0"
				Background="{DynamicResource CyberPanel}"
				BorderBrush="{DynamicResource CyberYellow}"
				BorderThickness="0,0,0,1"
				PointerPressed="OnTitleBarPressed">
			<Grid ColumnDefinitions="Auto,*,Auto">

				<TextBlock Grid.Column="0"
						   Text="◤ DJANGI TOOLBOX"
						   Foreground="{DynamicResource CyberYellow}"
						   FontWeight="Bold"
						   FontSize="14"
						   VerticalAlignment="Center"
						   Margin="16,0,0,0"/>

				<StackPanel Grid.Column="2" Orientation="Horizontal">
					<Button Name="MinimizeBtn" Content="—" Classes="icon" Width="44" Height="32"
							Background="Transparent" Click="OnMinimize"/>
					<Button Name="MaximizeBtn" Content="▢" Classes="icon" Width="44" Height="32"
							Background="Transparent" Click="OnMaximizeToggle"/>
					<Button Name="CloseBtn" Content="✕" Classes="icon close" Width="44" Height="32"
							Background="Transparent"
							Click="OnClose"/>
				</StackPanel>

			</Grid>
		</Border>

		<!-- ===== Content Area ===== -->
		<Grid Grid.Row="1" ColumnDefinitions="220,*">

			<!-- Nav rail -->
			<Border Grid.Column="0"
					Background="{DynamicResource CyberPanel}"
					BorderBrush="{DynamicResource CyberBorder}"
					BorderThickness="0,0,1,0">
				<StackPanel Margin="12,20,12,0" Spacing="8">

					<TextBlock Text="// MODULES"
							   Classes="dim"
							   Margin="8,0,0,8"/>

					<Button Command="{Binding NavigateHomeCommand}"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Left"
							Content="◤ HOME"
							Classes="glitch"
							Classes.active="{Binding IsHomeActive}"/>

					<Button Command="{Binding NavigateCodeZipperCommand}"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Left"
							Content="◤ CODEZIPPER"
							Classes="glitch"
							Classes.active="{Binding IsZipActive}"/>

				</StackPanel>
			</Border>

			<!-- Content area with page transition -->
			<Border Grid.Column="1" ClipToBounds="True">
                <Grid>
                    <ContentControl Content="{Binding CurrentPage}"/>

                    <!-- Blocks get generated here at runtime -->
                    <StackPanel Name="DissolveLayer"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"/>
                </Grid>
            </Border>

		</Grid>

		<!-- ===== Boot overlay (covers body only, not title bar) ===== -->
		<Grid Name="BootOverlay"
			  Grid.Row="1"
			  Background="{DynamicResource CyberBg}"
			  IsVisible="{Binding Boot.IsVisible}">

			<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
						Spacing="16" Width="680">

				<!-- Title with pulse animation -->
				<TextBlock Text="DJANGI TOOLBOX"
						   Classes="hero"
						   FontSize="56"
						   HorizontalAlignment="Center"
						   Foreground="{DynamicResource CyberYellow}">
					<TextBlock.Effect>
						<DropShadowEffect Color="#FCE22A" BlurRadius="28"
										  OffsetX="0" OffsetY="0" Opacity="0.9"/>
					</TextBlock.Effect>
					<TextBlock.Styles>
						<Style Selector="TextBlock">
							<Style.Animations>
								<Animation Duration="0:0:2"
										   IterationCount="INFINITE"
										   PlaybackDirection="Alternate">
									<KeyFrame Cue="0%">
										<Setter Property="Opacity" Value="1"/>
									</KeyFrame>
									<KeyFrame Cue="100%">
										<Setter Property="Opacity" Value="0.65"/>
									</KeyFrame>
								</Animation>
							</Style.Animations>
						</Style>
					</TextBlock.Styles>
				</TextBlock>

				<TextBlock Text="// SYSTEM BOOT SEQUENCE v0.1"
						   Classes="dim"
						   HorizontalAlignment="Center"/>

				<!-- Boot log panel -->
				<Border Classes="panel accent" Padding="24,20" Margin="0,20,0,0">
					<StackPanel Spacing="6">

						<ItemsControl ItemsSource="{Binding Boot.Lines}" MinHeight="140">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding}"
											   FontFamily="Consolas"
											   FontSize="13"
											   Foreground="{DynamicResource CyberGreen}"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<!-- Progress bar -->
						<Grid Margin="0,12,0,0" ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="LOAD"
                                       Classes="dim"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <!-- Track -->
                            <Border Grid.Column="1"
                                    Height="6"
                                    Background="#1F2A36"
                                    VerticalAlignment="Center">
                                <!-- Fill: stretches the full track, then scales on X -->
                                <Border HorizontalAlignment="Stretch"
                                        Background="{DynamicResource CyberYellow}"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Boot.Progress}"/>
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FCE22A"
                                                          BlurRadius="12"
                                                          OffsetX="0" OffsetY="0"
                                                          Opacity="0.85"/>
                                    </Border.Effect>
                                </Border>
                            </Border>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Boot.ProgressPercent}"
                                       Classes="dim"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>
                        </Grid>

					</StackPanel>
				</Border>

				<!-- ACCESS GRANTED -->
				<TextBlock Text="ACCESS GRANTED"
						   Classes="hero"
						   FontSize="26"
						   HorizontalAlignment="Center"
						   IsVisible="{Binding Boot.IsComplete}"
						   Foreground="{DynamicResource CyberGreen}"
						   Margin="0,8,0,0">
					<TextBlock.Effect>
						<DropShadowEffect Color="#3DFFA0" BlurRadius="24"
										  OffsetX="0" OffsetY="0" Opacity="0.9"/>
					</TextBlock.Effect>
				</TextBlock>

			</StackPanel>
		</Grid>

		<!-- ===== Resize Grips (invisible, sit on top of edges) ===== -->
		<Grid Name="ResizeGrips" Grid.Row="0" Grid.RowSpan="2">

			<!-- Edges -->
			<Border Height="6" VerticalAlignment="Top" HorizontalAlignment="Stretch"
					Background="Transparent"
					Cursor="SizeNorthSouth"
					PointerPressed="OnResizeTop"/>
			<Border Height="6" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
					Background="Transparent"
					Cursor="SizeNorthSouth"
					PointerPressed="OnResizeBottom"/>
			<Border Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch"
					Background="Transparent"
					Cursor="SizeWestEast"
					PointerPressed="OnResizeLeft"/>
			<Border Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
					Background="Transparent"
					Cursor="SizeWestEast"
					PointerPressed="OnResizeRight"/>

			<!-- Corners (bigger hit area) -->
			<Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
					Background="Transparent"
					Cursor="TopLeftCorner"
					PointerPressed="OnResizeTopLeft"/>
			<Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
					Background="Transparent"
					Cursor="TopRightCorner"
					PointerPressed="OnResizeTopRight"/>
			<Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
					Background="Transparent"
					Cursor="BottomLeftCorner"
					PointerPressed="OnResizeBottomLeft"/>
			<Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
					Background="Transparent"
					Cursor="BottomRightCorner"
					PointerPressed="OnResizeBottomRight"/>

		</Grid>
	</Grid>
</Window>
