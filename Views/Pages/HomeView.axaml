<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DjangiToolbox.ViewModels.Pages"
             x:Class="DjangiToolbox.Views.Pages.HomeView"
             x:DataType="vm:HomeViewModel">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <TextBlock Text="{Binding Greeting}" Classes="hero" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Subtitle}" Classes="dim"  HorizontalAlignment="Center"/>

            <Border Classes="panel accent" Width="440" Margin="0,24,0,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="SYSTEM STATUS"
                               Foreground="{DynamicResource CyberYellow}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="• All subsystems nominal"/>
                    <TextBlock Text="• Choose a tool from the left rail"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>